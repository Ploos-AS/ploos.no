---
interface Props {lang?: 'nb' | 'en'}
const {lang='nb'}=Astro.props;
const en=lang==='en';
const endpoint=import.meta.env.PUBLIC_CONTACT_ENDPOINT;
const siteKey=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const configured=Boolean(endpoint && siteKey);
---
{configured ? (
<form class="contact-form card" data-contact-form novalidate>
  <div class="form-grid">
    <label>{en?'Name':'Navn'} <input name="name" required maxlength="120" autocomplete="name" /></label>
    <label>{en?'Your email address':'Din e-postadresse'} <input name="email" type="email" required maxlength="254" autocomplete="email" /></label>
  </div>
  <label>{en?'Subject':'Emne'} <input name="subject" required maxlength="160" /></label>
  <label>{en?'Message':'Melding'} <textarea name="message" required maxlength="5000" rows="7"></textarea></label>
  <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" data-action="contact"></div>
  <p class="form-note">{en?'We use your details to reply to your enquiry. See our privacy notice. Do not include sensitive information.':'Vi bruker opplysningene til å svare på henvendelsen. Se personvernerklæringen. Ikke send sensitive opplysninger.'} <a href={en?'/en/privacy/':'/personvern/'}>{en?'Privacy notice':'Personvern'}</a></p>
  <button type="submit">{en?'Send message':'Send melding'}</button>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
</form>
) : (
<p class="form-note" role="status">{en?'Our contact form is being configured and is temporarily unavailable.':'Kontaktskjemaet blir konfigurert og er midlertidig utilgjengelig.'}</p>
)}
{configured && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
const endpoint=import.meta.env.PUBLIC_CONTACT_ENDPOINT;
if(endpoint) document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(form=>{
  const status=form.querySelector<HTMLElement>('[data-form-status]')!;
  const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const en=document.documentElement.lang==='en';
  form.addEventListener('submit',async event=>{
    event.preventDefault();
    if(!form.reportValidity()) return;
    const data=Object.fromEntries(new FormData(form));
    if(!data['cf-turnstile-response']){
      status.textContent=en?'Complete the anti-spam check first.':'Fullfør spamkontrollen først.';
      return;
    }
    button.disabled=true;
    status.textContent=en?'Sending…':'Sender…';
    try{
      const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data),mode:'cors'});
      if(!response.ok) throw new Error('Delivery failed');
      form.reset();
      (window as any).turnstile?.reset();
      status.textContent=en?'Your message has been sent.':'Meldingen din er sendt.';
    }catch{
      (window as any).turnstile?.reset();
      status.textContent=en?'Unable to send right now. Please try again later.':'Kunne ikke sende nå. Prøv igjen senere.';
    }finally{button.disabled=false}
  });
});
</script>
